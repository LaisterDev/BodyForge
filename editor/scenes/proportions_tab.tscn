[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/proportions_tab.gd" id="1"]

[node name="ProportionsTab" type="VBoxContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Copy" type="VBoxContainer" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="Header/Copy"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Body proportions"

[node name="Count" type="HBoxContainer" parent="Header"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ResetAll" type="Button" parent="Header/Count"]
layout_mode = 2
size_flags_vertical = 4
text = "Reset all"

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="AnatomyHeader" type="Label" parent="Scroll/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "Anatomy"

[node name="AnatomyList" type="VBoxContainer" parent="Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="BonesHeader" type="HBoxContainer" parent="Scroll/Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Scroll/Content/BonesHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 17
text = "Advanced skeleton"

[node name="BonesVisibleToggle" type="CheckButton" parent="Scroll/Content/BonesHeader"]
layout_mode = 2
text = "Show bone controls"

[node name="BonesOptions" type="HBoxContainer" parent="Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BonesHelp" type="Label" parent="Scroll/Content/BonesOptions"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.58, 0.61, 0.67, 1)
text = "Optional low-level controls. Character creation does not require editing bones."
autowrap_mode = 2

[node name="SymmetryToggle" type="CheckButton" parent="Scroll/Content/BonesOptions"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 4
button_pressed = true
text = "Symmetry"
tooltip_text = "Use one control for both left and right bones"

[node name="BoneList" type="VBoxContainer" parent="Scroll/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[connection signal="pressed" from="Header/Count/ResetAll" to="." method="reset_all"]
[connection signal="toggled" from="Scroll/Content/BonesHeader/BonesVisibleToggle" to="." method="_on_bones_visible_toggled"]
[connection signal="toggled" from="Scroll/Content/BonesOptions/SymmetryToggle" to="." method="_on_symmetry_toggled"]
