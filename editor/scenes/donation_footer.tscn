layout_mode = 2
text = "Address"

[node name="AddressRow" type="HBoxContainer" parent="DonationDialog/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="AddressEdit" type="LineEdit" parent="DonationDialog/Content/AddressRow"]
