<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BodyForge</AssemblyName>
    <RootNamespace>BodyForge</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin-dev/**;obj-dev/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BodyForgeDev)' == 'true'">
    <DefineConstants>$(DefineConstants);BODYFORGE_DEV</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../editor/dev/anatomy_calibration.json"
                      LogicalName="BodyForge.anatomy_calibration.json" />
  </ItemGroup>
</Project>
