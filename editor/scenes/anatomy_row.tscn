[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/anatomy_row.gd" id="1"]

[node name="AnatomyRow" type="HBoxContainer"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_override_constants/separation = 10
