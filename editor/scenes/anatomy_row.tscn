layout_mode = 2
min_value = -1.0
max_value = 1.0
step = 0.01
allow_greater = false
allow_lesser = false

[connection signal="value_changed" from="Slider" to="." method="_on_slider_changed"]
[connection signal="value_changed" from="ValueBox" to="." method="_on_value_box_changed"]
