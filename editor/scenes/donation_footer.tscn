[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/donation_footer.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/donations/buy-me-a-coffee.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/donations/bitcoin.png" id="3"]
[ext_resource type="Texture2D" path="res://assets/donations/lightning.png" id="4"]

[node name="DonationFooter" type="PanelContainer"]
custom_minimum_size = Vector2(0, 48)
script = ExtResource("1")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SupportLabel" type="Label" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.58, 0.61, 0.67, 1)
text = "Support BodyForge"

[node name="CoffeeButton" type="TextureButton" parent="Row"]
custom_minimum_size = Vector2(132, 37)
layout_mode = 2
texture_normal = ExtResource("2")
ignore_texture_size = true
stretch_mode = 4
tooltip_text = "Open Buy Me a Coffee"

[node name="BitcoinButton" type="Button" parent="Row"]
layout_mode = 2
text = "Bitcoin"
tooltip_text = "Show Bitcoin QR code and address"

[node name="LightningButton" type="Button" parent="Row"]
layout_mode = 2
text = "Lightning"
tooltip_text = "Show Lightning QR code and address"

[node name="DonationDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
initial_position = 2
size = Vector2i(430, 430)
min_size = Vector2i(390, 400)
ok_button_text = "Close"

[node name="Content" type="VBoxContainer" parent="DonationDialog"]
offset_left = 24.0
offset_top = 48.0
offset_right = 406.0
offset_bottom = 374.0
theme_override_constants/separation = 8

[node name="QrImage" type="TextureRect" parent="DonationDialog/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(230, 230)
layout_mode = 2
texture = ExtResource("3")
expand_mode = 3
stretch_mode = 5

[node name="AddressLabel" type="Label" parent="DonationDialog/Content"]
